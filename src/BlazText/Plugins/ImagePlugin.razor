@namespace BlazText.Plugins
@inherits BlazTextPluginBase
@using Microsoft.AspNetCore.Components.Forms

@code {
    private ToolbarItem? _item;
    private string? _error;

    /// <summary>
    /// Maximum accepted file size, in bytes. Defaults to 5,000,000 bytes, which is 5 MB.
    /// </summary>
    /// <remarks>
    /// The limit is enforced against this exact value — set it precisely if it has to line up
    /// with a request body limit or a provider cap. Only the message shown to the user is
    /// rounded, and always downwards, so it can never state a larger limit than is enforced.
    /// An inserted image's exact size is <c>EmbeddedImage.Data.Length</c>.
    /// </remarks>
    [Parameter]
    public long MaxFileSizeBytes { get; set; } = 5_000_000;

    /// <summary>The file input's accept filter.</summary>
    [Parameter]
    public string Accept { get; set; } = "image/*";

    [Parameter]
    public int Order { get; set; } = 30;

    /// <summary>Raised after an image was added to the document.</summary>
    [Parameter]
    public EventCallback<EmbeddedImage> ImageInserted { get; set; }

    protected override Task OnEditorInitializedAsync()
    {
        _item = new ToolbarItem { Id = "blaztext-image", Order = Order, Content = Button };
        Editor.RegisterToolbarItem(_item);
        return Task.CompletedTask;
    }

    protected override ValueTask OnDisposingAsync()
    {
        if (_item is not null)
        {
            Editor.UnregisterToolbarItem(_item);
        }

        return ValueTask.CompletedTask;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        var file = e.File;

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _error = "Not an image file.";
            Editor.RequestRefresh();
            return;
        }

        if (file.Size > MaxFileSizeBytes)
        {
            _error = $"Image exceeds the {FormatSize(MaxFileSizeBytes)} limit.";
            Editor.RequestRefresh();
            return;
        }

        using var stream = new MemoryStream();
        await file.OpenReadStream(MaxFileSizeBytes).CopyToAsync(stream);

        var image = new EmbeddedImage
        {
            FileName = file.Name,
            ContentType = file.ContentType,
            Data = stream.ToArray(),
        };

        await Api.UpdateDocumentAsync(d => d.Images.Add(image));

        // The DOM shows the data: URI; getContent normalizes it back to blaztext:{id}
        // via the data-blaztext-id marker, so the stored document stays blob-free.
        await Api.InsertHtmlAtSelectionAsync(
            $"<img data-blaztext-id=\"{image.Id}\" src=\"{image.ToDataUri()}\" alt=\"{file.Name}\">");

        await ImageInserted.InvokeAsync(image);
        Editor.RequestRefresh();
    }

    /// <summary>
    /// Renders a byte count in the largest unit that keeps it readable. MaxFileSizeBytes is
    /// developer-supplied and need not be a whole number of megabytes.
    /// </summary>
    /// <remarks>
    /// Decimal units, so a limit written as 2_000_000 reads back as "2 MB" rather than "1.9 MB".
    /// Truncated rather than rounded: this number is a <em>limit</em>, and rounding up would
    /// advertise one more permissive than the code enforces — a 1_549_000 limit rounds to
    /// "1.5 MB" while rejecting a 1.5 MB file. Truncating can only ever understate.
    /// </remarks>
    internal static string FormatSize(long bytes)
    {
        const long Kb = 1000;
        const long Mb = Kb * 1000;
        const long Gb = Mb * 1000;

        return bytes switch
        {
            >= Gb => $"{Truncate(bytes / (double)Gb)} GB",
            >= Mb => $"{Truncate(bytes / (double)Mb)} MB",
            >= Kb => $"{Truncate(bytes / (double)Kb)} KB",
            _ => $"{bytes} bytes",
        };

        // Truncating before formatting also keeps the unit branch honest: rounding afterwards
        // turned 1_048_575 into "1024 KB" instead of "1 MB".
        static string Truncate(double value) => (Math.Truncate(value * 10) / 10).ToString("0.#");
    }

    private RenderFragment Button => @<span style="display: contents">
        <label class="blaztext-btn" title="Insert image" style="margin: 0">
            🖼
            <InputFile OnChange="OnFileSelected" accept="@Accept" style="display: none" />
        </label>
        @if (_error is not null)
        {
            <span class="blaztext-muted" role="alert">@_error</span>
        }
    </span>;
}
