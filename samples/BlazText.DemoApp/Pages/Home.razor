@page "/"

<PageTitle>BlazText — Bare editor</PageTitle>

<h1>Bare editor</h1>
<p>
    A <code>&lt;BlazTextEditor&gt;</code> with no plugins renders its bare minimum:
    an editable surface with two-way content binding. Everything else is added by
    placing plugin components inside it — see the other pages.
</p>

<BlazTextEditor @bind-Value="_content" Placeholder="Start typing…" />

<h5 class="mt-4">Bound value</h5>
<pre class="border rounded p-2 bg-light"><code>@_content</code></pre>

@code {
    private string _content = "<p>Hello from <b>BlazText</b>! Native shortcuts like Ctrl+B still work here.</p>";
}
