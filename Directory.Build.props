<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata defaults">
    <Authors>Mike de Groot</Authors>
    <Product>BlazText</Product>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- TODO: update once the GitHub repository exists -->
    <PackageProjectUrl>https://github.com/mikedegroot/BlazText</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mikedegroot/BlazText</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;rich-text-editor;wysiwyg;liquid;email;templates</PackageTags>
  </PropertyGroup>

</Project>
